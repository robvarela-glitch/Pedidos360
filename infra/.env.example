# Copiar como ".env" dentro de infra/ (NO subir .env a GitHub: está en .gitignore).
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# ---- Microsoft Entra ID ----
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Client ID de la App Registration de Pedidos360 (la misma expone la API access_as_user)
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_REQUIRED_SCOPE=access_as_user
# Rol que se asigna a usuarios del tenant SIN App role (dejar vacío para exigir rol explícito)
DEFAULT_ROLE=Cliente

# ---- Frontend ----
# URL que usa el navegador para llamar al backend.
#   Vacío (recomendado) = mismo origen: en local nginx reenvía /api al BFF y en la nube el
#   frontend se abre desde la URL del API Gateway, que enruta /api/* al BFF con JWT.
#   También puede ser absoluta, ej. https://xxxx.execute-api.us-east-1.amazonaws.com
FRONTEND_API_BASE_URL=
FRONTEND_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
FRONTEND_PUBLIC_PORT=80
# Orígenes permitidos por CORS en el BFF (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost

# ---- Credenciales internas (cambiarlas en la nube) ----
ORACLE_PASSWORD=cambiar-esta-clave
ORACLE_APP_PASSWORD=cambiar-esta-clave
RABBITMQ_USER=pedidos360
RABBITMQ_PASSWORD=cambiar-esta-clave
RABBITMQ_ERLANG_COOKIE=cambiar-esta-cookie-larga-y-secreta
# Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-esta-clave

# ---- Opcionales ----
BFF_PUBLIC_PORT=8080
JVM_MAX_HEAP=256m
KAFKA_ENABLED=false
# Permite simular fallos (header x-simulate-failure) para demostrar reintentos y DLQ
RABBIT_ALLOW_FAILURE_SIMULATION=true
